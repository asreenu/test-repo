<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.macstudio.finder</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/python3</string>
      <string>/ABS/PATH/TO/mac-studio-finder/run_search.py</string>
      <string>--config</string>
      <string>/ABS/PATH/TO/mac-studio-finder/config.yaml</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/ABS/PATH/TO/mac-studio-finder</string>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.mac-studio-finder/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.mac-studio-finder/launchd.err.log</string>
  </dict>
</plist>
